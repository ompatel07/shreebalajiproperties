# ─────────────────────────────────────────────────────────────
# Supabase — Project Settings → API
# ─────────────────────────────────────────────────────────────
# Safe to expose to the browser. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SERVER ONLY. Bypasses every RLS policy — never prefix with NEXT_PUBLIC_,
# never import into a Client Component. Used only by admin server actions.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://shreebalajiproperties.in

# Comma-separated emails allowed into /studio (the admin panel).
# Enforced in middleware AND again in the DB via RLS.
ADMIN_EMAILS=owner@example.com

# Optional: revalidate-on-demand secret for the webhook route
REVALIDATE_SECRET=change-me-to-a-long-random-string
